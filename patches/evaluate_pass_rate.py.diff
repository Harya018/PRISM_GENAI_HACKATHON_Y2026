+def llm_judge_argument_gemini(expected_args: dict, actual_args: dict,
+                              function_name: str) -> Tuple[bool, str]:
+    client = _get_gemini_client()
+    if client is None:
+        return exact_match_args(expected_args, actual_args)
+    prompt = _argument_judge_prompt(expected_args, actual_args, function_name)
+    try:
+        resp = client.models.generate_content(model=GEMINI_PROXY_MODEL, contents=prompt)
+        raw = _strip_json_fences(resp.text)
+        result = json.loads(raw)
+        return result["correct"], result["explanation"]
+    except Exception:
+        return exact_match_args(expected_args, actual_args)
+
