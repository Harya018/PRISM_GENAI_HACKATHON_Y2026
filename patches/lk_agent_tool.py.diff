+# Compatibility fix for current livekit-agents (1.8.x; repo pins ~=1.3 which allows it):
+# plugins now enforce "must be registered on the main thread" (Plugin.register_plugin, run as an
+# import-time side effect) and raise RuntimeError if that import is deferred into the per-job
+# async entrypoint, as the original lazy `from livekit.plugins import X` inside
+# get_realtime_model() did. Import the one plugin we need eagerly, at module load (main thread),
+# instead. Local compatibility patch only — does not touch benchmark logic or scoring.
+_provider_lc = PROVIDER.lower()
+_PLUGIN_MODULE = None
+if _provider_lc == "grok":
+    from livekit.plugins import xai as _PLUGIN_MODULE
+elif _provider_lc in ("gpt_realtime", "azure_openai"):
+    from livekit.plugins import openai as _PLUGIN_MODULE
+elif _provider_lc in ("gemini2_5", "gemini3_1"):
+    from livekit.plugins import google as _PLUGIN_MODULE
+elif _provider_lc == "ultravox":
+    from livekit.plugins import ultravox as _PLUGIN_MODULE
+
 
