# Copy to .env, fill in, never commit .env itself (gitignored — verify with `git check-ignore .env`).
# scripts/run_fdb_v3.sh loads this file directly (`set -a; source .env; set +a`).

# --- Required: LiveKit Cloud (free tier: https://cloud.livekit.io) ---
# Needed to run inference. FDB-v3's evaluation scripts do NOT need LiveKit, only inference does
# (Full-Duplex-Bench/v3/README.md).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Required: our declared provider ---
# LK_PROVIDER=gemini2_5 (default, see agent/lk_agent.py and README.md) uses Gemini Live.
GOOGLE_API_KEY=your_google_api_key

# --- Required: LLM judge for --use-llm ---
# evaluate_tool_calls.py / evaluate_pass_rate.py always call gpt-4o as the judge when --use-llm
# is passed, regardless of which provider ran the agent. The official evaluation policy runs
# with the judge enabled ("a single pinned judge, so every team is judged identically" - the
# updated participant guide), and scripts/run_fdb_v3.sh always passes --use-llm to match that -
# so this key is needed for OUR OWN local numbers to mean what the official run's numbers mean,
# even though our agent itself uses Gemini, not OpenAI.
OPENAI_API_KEY=your_openai_api_key

# --- Optional: only if you also want to run/compare the GPT Realtime or cascaded providers ---
# (LK_PROVIDER=gpt_realtime or LK_PROVIDER=cascaded) reuse the same OPENAI_API_KEY above.
